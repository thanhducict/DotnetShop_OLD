@model IngredientListViewModel

<h1>@Model.CurrentCategory</h1>

@foreach (var ingredient in Model.Ingredients)
{
    <div class="col-sm-4 col-lg-4 col-md-4">
        <div class="thumbnail">
            <img src="@ingredient.ImageThumbnailUrl" alt="">
            <div class="caption">
                <h3 class="pull-right">@ingredient.Price.ToString("c")</h3>
                <h3>
                    <a>@ingredient.Name</a>
                </h3>
                <p>@ingredient.ShortDescription</p>
            </div>
        </div>
    </div>
}
