@using DotnetShop.Domain
@model Product

@{
    ViewData["Title"] = "Create";
}

<h2>Create a new product</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="@Model.Name" class="form-label"></label>
        <input asp-for="@Model.Name" class="form-control" />
        <span class="text-danger" asp-validation-for="@Model.Name"></span>
    </div>
    <div class="mb-3">
        <label asp-for="@Model.ShortDescription" class="form-label"></label>
        <input asp-for="@Model.ShortDescription" class="form-control" />
        <span class="text-danger" asp-validation-for="@Model.ShortDescription"></span>
    </div>
    <div class="mb-3">
        <label asp-for="@Model.LongDescription" class="form-label"></label>
        <input asp-for="@Model.LongDescription" class="form-control" />
        <span class="text-danger" asp-validation-for="@Model.LongDescription"></span>
    </div>
    <div class="mb-3">
        <label asp-for="@Model.Price" class="form-label"></label>
        <input asp-for="@Model.Price" class="form-control" />
        <span class="text-danger" asp-validation-for="@Model.Price"></span>
    </div>
    <div class="mb-3">
        <label asp-for="@Model.ImageThumbnailUrl" class="form-label"></label>
        <input asp-for="@Model.ImageThumbnailUrl" class="form-control" type="file">
        <span class="text-danger" asp-validation-for="@Model.ImageThumbnailUrl"></span>
    </div>
    <div class="mb-3">
        <label asp-for="@Model.ImageUrl" class="form-label"></label>
        <input asp-for="@Model.ImageUrl" class="form-control" type="file">
        <span class="text-danger" asp-validation-for="@Model.ImageUrl"></span>
    </div>
    <div class="mb-3">
        <input type="checkbox" asp-for="@Model.IsProductOfTheWeek" class="form-check-input" />
        <label asp-for="@Model.IsProductOfTheWeek" class="form-label"></label>
        <span class="text-danger" asp-validation-for="@Model.IsProductOfTheWeek"></span>
    </div>
    <div class="mb-3">
        <input type="checkbox" asp-for="@Model.InStock" class="form-check-input" />
        <label asp-for="@Model.InStock" class="form-label"></label>
        <span class="text-danger" asp-validation-for="@Model.InStock"></span>
    </div>
    <div class="mb-3">
        <label asp-for="@Model.Category" class="form-label"></label>
        <select class="form-control" asp-for="@Model.CategoryId"
                asp-items="ViewBag.Categories"></select>
        <span class="text-danger" asp-validation-for="@Model.Category"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
</form>