@using DotnetShop.Data.Domain
@model Product

<div class="col-sm-6 col-md-4 col-lg-3">
    <div class="card mt-3 mb-3">
        <img src="@Model.ImageThumbnailUrl" class="card-img-top">
        <div class="card-body">
            <h5 class="card-title">@Model.Price.ToString("c")</h5>
            <h3>
                <a asp-page="/Products/Details" asp-route-id="@Model.ProductId" style="font-size: 20px;">
                    @Model.Name
                </a>
            </h3>
            <p class="card-text">@Model.ShortDescription</p>
            <a class="btn btn-primary"
                asp-page="/Cart"
                asp-page-handler="AddToCart"
                asp-route-productId="@Model.ProductId">Add to cart</a>
        </div>
    </div>
</div>
