@model LoginPartialViewModel

@if (Model.IsSignedIn)
{
    <form asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index")" method="post" id="logoutForm">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a asp-page="/Account/Manage/Index" class="btn btn-link navbar-btn navbar-link">Hello @Model.Username!</a>
            </li>
            <li class="nav-item">
                <button type="submit" class="btn btn-link navbar-btn navbar-link">Logout</button>
            </li>
        </ul>
    </form>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item"><a asp-page="/Account/Register" class="nav-link text-dark">Register</a></li>
        <li class="nav-item"><a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl" class="nav-link text-dark">Login</a></li>
    </ul>
}
