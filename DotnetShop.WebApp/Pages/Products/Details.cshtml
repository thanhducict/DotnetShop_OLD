@page
@model DotnetShop.WebApp.Pages.Products.DetailsModel

<h2>@Model.Product.Name</h2>

<div class="thumbnail">
    <img alt="@Model.Product.Name" src="@Model.Product.ImageUrl" width="600" >
    <div class="caption-full">
        <h3 class="pull-right">@Model.Product.Price</h3>
        <h3>
            <a href="#">@Model.Product.Name</a>
        </h3>
        <h4>@Model.Product.ShortDescription</h4>
        <p>@Model.Product.LongDescription</p>
        <div>
            <a class="btn btn-primary" 
                asp-page="/Cart"
                asp-page-handler="AddToCart"
                asp-route-productId="@Model.Product.ProductId">Add to cart</a>
        </div>
    </div>
</div>