@page
@model CartModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<h2>Your shopping cart</h2>
<h4>Here are the items in your shopping cart.</h4>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Selected amount</th>
            <th>Product</th>
            <th class="text-right">Price</th>
            <th class="text-right">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var line in Model.CartViewModel.CartLineItemViewModels)
        {
            <tr>
                <td class="text-center">@line.CartLineItemQuantity</td>
                <td class="text-left">@line.ProductName</td>
                <td class="text-right">@line.ProductPrice.ToString("c")</td>
                <td class="text-right">@line.CartLineItemTotal.ToString("c")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-right">Total:</td>
            <td class="text-right">
                @Model.CartViewModel.CartTotal.ToString("c")
            </td>
        </tr>
    </tfoot>
</table>

<div class="text-center">
    <form asp-page-handler="Checkout" method="post">
        <button class="btn btn-primary" type="submit">Check out now!</button>
    </form>
</div>
